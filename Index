
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Dune Dash</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;background:#111;overflow:hidden}
#unity-container{width:100%;height:100%;display:flex;align-items:center;justify-content:center}
#unity-canvas{width:100%;height:100%;object-fit:contain;touch-action:none}
#status{position:absolute;bottom:15px;left:0;width:100%;text-align:center;color:white;font:14px Arial}
#bar{width:80%;max-width:350px;height:7px;background:#555;margin:10px auto;border-radius:8px;overflow:hidden}
#progress{height:100%;width:0;background:#fff}
</style>
</head>
<body>
<div id="unity-container">
<canvas id="unity-canvas" width="2360" height="1376"></canvas>
</div>
<div id="status">Loading Dune Dash...</div>
<div id="bar"><div id="progress"></div></div>

<script src="https://cdn.jsdelivr.net/gh/KathleenAndrea/active@987cf3b8db590fcf991e08bfb879806977caf1b9/src/active.js"></script>
<script>
const base="https://cdn.jsdelivr.net/gh/KathleenAndrea/active@987cf3b8db590fcf991e08bfb879806977caf1b9/src/";
const canvas=document.getElementById("unity-canvas");
const status=document.getElementById("status");
const progress=document.getElementById("progress");

const config={
 dataUrl:base+"data.br",
 frameworkUrl:base+"framework.js",
 codeUrl:base+"wasm.br",
 innerLoaderUrl:base+"loader.js",
 streamingAssetsUrl:"https://cdn.jsdelivr.net/"
};

if(typeof startUnityBr!=="function"){
 status.textContent="Unity launcher unavailable.";
}else{
 startUnityBr(canvas,config,p=>{
  progress.style.width=(p*100)+"%";
  status.textContent="Loading Dune Dash... "+Math.round(p*100)+"%";
 }).then(instance=>{
  window.duneDashInstance=instance;
  status.textContent="";
  document.getElementById("bar").style.display="none";
 }).catch(error=>{
  status.textContent="Game loading failed: "+error.message;
  console.error(error);
 });
}
</script>
</body>
</html>
